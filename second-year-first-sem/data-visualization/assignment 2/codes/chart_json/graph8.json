{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Chart 9: Player Age Distribution and The Experience Gap",
    "subtitle": [
      "By analyzing real player data from Kaggle, we observe the golden age for global pros falls between 24 and 26.",
      "Over 10% of global players remain active in top-tier tournaments even after age 30 (e.g., karrigan).",
      "However, lacking stable tier-2 leagues and salaries, many Oceania players are forced to retire in their early 20s.",
      "This 'gap in age and experience' is another hidden reason why Oceania struggles to cultivate world-class teams."
    ],
    "subtitleColor": "#555",
    "subtitlePadding": 5,
    "anchor": "start",
    "offset": 20
  },
  "width": 600,
  "height": 400,
  "padding": 20,
  "data": {
    "url": "../data/graph_9/age_distribution.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "age",
      "type": "quantitative",
      "title": "Age",
      "axis": {
        "tickMinStep": 1,
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#3182bd",
          "size": 3
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "white"},
            {"offset": 1, "color": "#9ecae1"}
          ]
        },
        "opacity": 0.8,
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "Percentage",
          "type": "quantitative",
          "title": "Player Percentage (%)",
          "axis": {
            "grid": true,
            "gridDash": [4, 4]
          }
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["age"],
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "y": {
          "field": "Percentage",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "gray",
        "strokeDash": [4, 2],
        "size": 1.5
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "age", "type": "quantitative", "title": "Age"},
          {"field": "Percentage", "type": "quantitative", "title": "Percentage (%)"},
          {"field": "Player_Count", "type": "quantitative", "title": "Player Count"}
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#e6550d",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "Percentage",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        }
      }
    }
  ]
}