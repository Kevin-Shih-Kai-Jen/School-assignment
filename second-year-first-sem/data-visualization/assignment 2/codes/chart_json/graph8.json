{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "CS2 Map Pool Depth: European Dominance vs. Oceania Struggles",
    "subtitle": [
      "Real data shows top European teams (e.g., Vitality) possess an extremely deep 'Map Pool', maintaining over 80% dominating win rates across 6 different maps.",
      "Conversely, Oceania teams typically only have 1 to 2 viable maps (specialty maps). This leads to a massive strategic disadvantage during the pre-match",
      "'Map Veto' phase, where they are easily forced by European teams to compete on maps they are not comfortable with."
    ],
    "subtitleFontSize": 13,
    "subtitleColor": "#555",
    "subtitlePadding": 15,
    "anchor": "start",
    "fontSize": 20
  },
  "data": {
    "url": "../data/graph_8/data.csv"
  },
  "transform": [
    {
      "fold": [
        "Dust2",
        "Mirage",
        "Inferno",
        "Nuke",
        "Overpass",
        "Ancient",
        "Anubis"
      ],
      "as": ["Map", "WinRateString"]
    },
    {
      "calculate": "datum.WinRateString === 'N/A' ? null : toNumber(replace(datum.WinRateString, '%', ''))",
      "as": "WinRate"
    },
    {
      "calculate": "datum.Team === 'FlyQuest' || datum.Team === 'Rooster' ? 'Oceania' : datum.Team === 'FURIA' ? 'Americas' : datum.Team === 'The MongolZ' ? 'Asia' : 'Europe'",
      "as": "Region"
    }
  ],
  "facet": {
    "row": {
      "field": "Region",
      "type": "nominal",
      "title": "Region",
      "header": {
        "labelFontSize": 14,
        "titleFontSize": 15,
        "labelFontWeight": "bold",
        "labelAngle": 0
      },
      "sort": ["Europe", "Americas", "Asia", "Oceania"]
    }
  },
  "spec": {
    "width": 700,
    "height": 120, 
    "encoding": {
      "x": {
        "field": "Map",
        "type": "nominal",
        "axis": {
          "labelAngle": 0,
          "title": "Map",
          "titleFontSize": 14,
          "labelFontSize": 12
        }
      },
      "y": {
        "field": "Team",
        "type": "nominal",
        "axis": {
          "title": null,
          "labelFontSize": 12
        },
        "sort": null
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rect",
          "tooltip": true
        },
        "encoding": {
          "color": {
            "condition": {
              "test": "datum.WinRate === null",
              "value": "#f0f0f0"
            },
            "field": "WinRate",
            "type": "quantitative",
            "scale": {
              "scheme": "blues",
              "domain": [0, 100]
            },
            "legend": {
              "title": "Win Rate (%)",
              "titleFontSize": 12
            }
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "baseline": "middle",
          "fontSize": 12,
          "fontWeight": "bold"
        },
        "encoding": {
          "text": {
            "field": "WinRateString",
            "type": "nominal"
          },
          "color": {
            "condition": [
              {
                "test": "datum.WinRate === null",
                "value": "#999"
              },
              {
                "test": "datum.WinRate < 55",
                "value": "black"
              }
            ],
            "value": "white"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}