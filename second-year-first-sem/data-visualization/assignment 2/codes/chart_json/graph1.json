{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 400,
    "title": "Global CS Esports Prize Money Distribution",

    "projection": {
        "type": "equalEarth"
    },

    "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },

    "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5,
        "tooltip": true
    },

    "transform": [
    {
      "lookup": "properties.NAME", 
      "from": {
        "data": {
          "url": "../data/graph_1/cs_prize_money.csv" 
        },
        "key": "Country",
        "fields": ["Prize_Money"]
      }
    }
  ],

  "encoding": {
    "color": {
        "field": "Prize_Money",
        "type": "quantitative",
        "scale": {"scheme": "bluegreen"}
    }
  }
}